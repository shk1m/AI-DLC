# FoodLens Backend 환경 변수 설정
# 이 파일을 .env로 복사하여 사용하세요
# .env는 .gitignore에 등록되어 있어 커밋되지 않습니다

# 앱 설정
APP_NAME=FoodLens API
APP_VERSION=1.0.0
DEBUG=true

# DB 설정 (로컬 Docker, DB명: ai-dlc)
DATABASE_URL=postgresql+asyncpg://admin:password@localhost:5432/ai-dlc

# Redis 설정 (로컬 Docker)
REDIS_URL=redis://localhost:6379

# KAMIS API (농산물유통정보)
KAMIS_API_KEY=your_kamis_api_key
KAMIS_CERT_ID=your_cert_id

# 공공데이터포털 API
PUBLIC_DATA_API_KEY=your_public_data_api_key

# 네이버 API
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# AWS 설정 (워크샵 환경: us-east-1)
# 임시 STS 자격증명 사용 시 AWS_SESSION_TOKEN 필수
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Bedrock 모델 (us-east-1, Inference Profile ID, us. prefix 필수)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_ID_FAST=us.anthropic.claude-3-5-haiku-20241022-v1:0

# Neptune & S3 (시연: 로컬, 프로덕션: AWS)
NEPTUNE_ENDPOINT=
S3_BUCKET_NAME=foodlens-rag-docs

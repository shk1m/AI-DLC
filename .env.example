# =============================================================================
# FoodLens — Environment configuration template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# ---- Application ----
APP_ENV=local            # local | dev | prod
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
USE_MOCK=true            # 시연/테스트 안전성 (외부 호출 차단)

# ---- Database (PostgreSQL via Docker Compose) ----
DATABASE_URL=postgresql+asyncpg://admin:CHANGE_ME@localhost:5432/foodlens
DB_PASSWORD=CHANGE_ME

# ---- Cache / Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- AWS ----
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
S3_BUCKET=foodlens-rag-docs
BEDROCK_KB_ID=YOUR_KB_ID
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
NEPTUNE_ENDPOINT=wss://YOUR_NEPTUNE_CLUSTER:8182/gremlin

# ---- KAMIS API (농산물 시세) ----
KAMIS_API_KEY=YOUR_KAMIS_KEY
KAMIS_API_ID=YOUR_KAMIS_ID
KAMIS_BASE_URL=https://www.kamis.or.kr/service/price/xml.do

# ---- 공공데이터포털 ----
PUBLIC_DATA_API_KEY=YOUR_PUBLIC_DATA_KEY

# ---- Naver Open API (검색 + 데이터랩) ----
# 발급: https://developers.naver.com/apps
NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET
NAVER_NEWS_API_URL=https://openapi.naver.com/v1/search/news.json
NAVER_DATALAB_API_URL=https://openapi.naver.com/v1/datalab/search

# ---- News Crawler (정부 보도자료) ----
MAFRA_BASE_URL=https://www.mafra.go.kr
MOF_BASE_URL=https://www.mof.go.kr
CRAWLER_USER_AGENT=FoodLens-Crawler/0.1 (+contact@foodlens.local)
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_RETRIES=3

# ---- Resilience ----
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=30

# ---- Observability ----
ENABLE_STRUCTURED_LOGS=true
